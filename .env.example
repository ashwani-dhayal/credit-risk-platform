# =============================================================================
# Credit Risk Intelligence Platform - Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values you have.
# The app auto-detects which provider to use based on which key is present.
# Priority order: OPENAI_API_KEY  ->  GROQ_API_KEY  ->  GEMINI_API_KEY
# If NO key is set, the chatbot falls back to a deterministic rule-based parser
# (5 canned query intents) so the demo still works without internet.
# =============================================================================

# ---- LLM provider keys (set ONE of these) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Application configuration ----
# Path to the SQLite database (auto-created from CSVs on first run)
DB_PATH=data/processed/credit_risk.db

# Path to the trained model artifact
MODEL_PATH=models/lgbm_model.joblib

# Streamlit server settings (used by docker-compose)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Risk-band thresholds (probability of default)
RISK_LOW_MAX=0.20
RISK_MEDIUM_MAX=0.50

# LLM hardening
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=20
