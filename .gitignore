# ---- Project-specific ----
# Raw Kaggle data is too large for GitHub (~2.7 GB)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated artifacts (kept small ones, ignore caches)
*.log
logs/
.cache/
.pytest_cache/
.coverage
htmlcov/

# SQLite DB (regenerated from CSVs on first run)
*.db-journal
*.db-wal
*.db-shm

# OS / misc
*.bak
*.tmp
